# Copy values into your shell or deployment secret store. Do not commit .env.
CQ_DEMO_MODE=1
CQ_EMPLOYEE_PASSWORD=employee-change-this-password
CQ_HR_PASSWORD=hr-change-this-password
CQ_SESSION_TTL=7200
CQ_MAX_LOGIN_FAILURES=5
CQ_MAX_CLIENT_FAILURES=20
CQ_LOGIN_WINDOW=60
CQ_LOGIN_LOCK=60

# Public HTTPS deployment only:
CQ_COOKIE_SECURE=1

# Enable only behind a controlled reverse proxy that overwrites forwarding headers:
CQ_TRUST_PROXY=0

# Optional server settings
PORT=8000
CQ_QUIET=0
