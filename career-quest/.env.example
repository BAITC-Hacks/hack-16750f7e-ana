# Values are read from the process environment, not automatically from .env.
# Set your own passwords or omit them for random credentials printed at startup.
# CQ_EMPLOYEE_PASSWORD=<your-password>
# CQ_HR_PASSWORD=<your-password>
CQ_EMPLOYEE_ID=E0028
CQ_ALLOW_EXTERNAL_AI=0
# OPENAI_API_KEY=<secret>
# OPENAI_MODEL=<supported-model-id>
# CQ_STORAGE_PATH=./progress.sqlite
# Use Secure cookies only over HTTPS:
CQ_SECURE_COOKIE=0
PORT=8000
CQ_QUIET=0
